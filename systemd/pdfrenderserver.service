[Unit]
Description=PDFrenderServer PDF-to-image web server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/PDFrenderServer
Environment=PDFRENDERSERVER_CACHE_DIR=/var/cache/pdfrenderserver
ExecStart=/usr/bin/python3 -m pdfrenderserver.server --host 0.0.0.0 --port 443
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
CacheDirectory=pdfrenderserver
ReadWritePaths=/var/cache/pdfrenderserver

[Install]
WantedBy=multi-user.target

